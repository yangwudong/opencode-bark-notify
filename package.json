{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@jack-yang/opencode-bark-notify",
  "version": "1.1.1",
  "description": "Bark push notifications for OpenCode — get the agent's actual messages on your iPhone",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": {
      "import": "./index.ts"
    },
    "./server": {
      "import": "./index.ts"
    }
  },
  "engines": {
    "opencode": ">=1.4.3"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.19.5",
    "typescript": "^5.9.2",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "index.ts",
    "README.md"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "bark",
    "notification",
    "push-notification",
    "ios"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangwudong/opencode-bark-notify.git"
  },
  "homepage": "https://github.com/yangwudong/opencode-bark-notify#readme",
  "bugs": {
    "url": "https://github.com/yangwudong/opencode-bark-notify/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
